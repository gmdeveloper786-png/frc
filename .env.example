APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Local: true | Production: MUST be false (app refuses to boot if production + debug)
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Karachi
# Production: true (or omit — defaults to true when APP_ENV=production)
FORCE_HTTPS=

SANCTUM_TOKEN_EXPIRATION=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# Production: warning or error
LOG_LEVEL=debug

# Security headers (SecurityHeaders middleware). CSP off locally avoids breaking dev tools.
SECURITY_HEADERS=true
SECURITY_CSP=false
SECURITY_CSP_REPORT_ONLY=false
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_HSTS=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production: true (or omit — defaults to true when APP_ENV=production)
SESSION_SECURE_COOKIE=
SESSION_ENCRYPT=
SESSION_SAME_SITE=lax

# ── Production checklist (copy when deploying) ───────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# FORCE_HTTPS=true
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# SECURITY_CSP=true
# SECURITY_HSTS=true
# SANCTUM_TOKEN_EXPIRATION=1440

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Faizan Rehabilitation Centre"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
